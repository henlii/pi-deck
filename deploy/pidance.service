# Pidance 正式安装版 systemd 单元模板
# 安装目标：/etc/systemd/system/pidance.service
# 产品：@henlii/pidance；CLI：pidance；绑定 0.0.0.0:31415
# 勿改用其它产品 CLI；勿改绑定到其它监听端口；勿写 NVM 版本化 Node 路径

[Unit]
Description=Pidance (official install on 31415)
Documentation=file:///opt/pidance/current
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root

# Pi 会话与配置在 root 家目录；勿改为无权限的运行用户除非同步迁移数据
Environment=HOME=/root
Environment=PI_CODING_AGENT_DIR=/root/.pi/agent
# 使用标准 nvm Node 入口（绝对路径 /root/.nvm/versions/node/v24.18.0/bin），勿写 /root/.local 软连接
Environment=PATH=/root/.nvm/versions/node/v24.18.0/bin:/root/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production

# current 为 releases/<ver> 的符号链接；CLI 经 __dirname 找包内 .next
WorkingDirectory=/opt/pidance/current

# 稳定绝对路径：必须来自 current 安装树，禁止依赖全局 CLI
ExecStart=/opt/pidance/current/node_modules/.bin/pidance --hostname 0.0.0.0 --port 31415 --no-open

# 异常退出自动拉起；正常 stop（exit 0）不重启
Restart=on-failure
RestartSec=5

KillMode=control-group
TimeoutStopSec=30
LimitNOFILE=65536

# 日志进 journal：journalctl -u pidance.service
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pidance

# 不在此写入密钥；鉴权数据由 Pi 运行时读 PI_CODING_AGENT_DIR

[Install]
WantedBy=multi-user.target
